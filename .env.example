# ── Qdrant ──────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ecen_docs

# ── Embeddings (OpenAI-compatible) ──────────────────
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── TAMU LLM API ────────────────────────────────────
OPENAI_API_KEY=your-tamu-api-key
OPENAI_MODEL=protected.gpt-5
OPENAI_BASE_URL=https://chat-api.tamu.ai/openai

# ── Crawler ─────────────────────────────────────────
TARGET_URL=https://engineering.tamu.edu/electrical/index.html
CRAWL_DELAY_SECONDS=1                         # be polite to the server
MAX_PAGES=500

# ── Re-index schedule ───────────────────────────────
REINDEX_CRON=0 2 * * *                        # 2 AM daily

# ── Admin endpoint auth (REQUIRED in any deployed environment) ──
# /admin/reindex, /admin/stats and /admin/test-llm are gated on this shared
# secret, sent as the `X-Admin-Token` request header. Fails CLOSED: if this is
# blank, those endpoints return 503 rather than being open to the world.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=
# Local development only — set to 1 to bypass the check entirely. NEVER set
# this in a deployed environment.
ALLOW_INSECURE_ADMIN=

# ── Resilience knobs ────────────────────────────────
# LLM gateway: retries on transient failures (429/5xx/timeouts) with
# exponential backoff. 0 disables retrying.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
# Postgres pool: connections idle longer than this are validated with a
# `SELECT 1` before use, so connections the Supabase pooler dropped while idle
# are replaced instead of failing the request.
PG_VALIDATE_IDLE_SECS=60
# How long to wait for a free pooled connection under load before giving up.
PG_ACQUIRE_TIMEOUT=5

# ── In-app issue reporting (UI "Report a problem" → GitHub issue) ──
# Token with `issues: write` on the repo (fine-grained PAT). Leave blank to
# disable the /report-issue endpoint. Keep this server-side only — never expose.
GH_ISSUE_TOKEN=
GH_REPO=Aa-Rho-Hi/ECEN-Chatbot
